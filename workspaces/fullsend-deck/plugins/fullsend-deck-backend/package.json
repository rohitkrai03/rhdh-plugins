{
  "name": "@red-hat-developer-hub/backstage-plugin-fullsend-deck-backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/fullsend-deck/plugins/fullsend-deck-backend"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "configSchema": "config-schema.d.ts",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "fullsend-deck",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-fullsend-deck",
      "@red-hat-developer-hub/backstage-plugin-fullsend-deck-backend",
      "@red-hat-developer-hub/backstage-plugin-fullsend-deck-common"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "export-dynamic": "rhdh-cli plugin export --clean --embed-package @red-hat-developer-hub/backstage-plugin-fullsend-deck-common",
    "package-dynamic": "rhdh-cli plugin package --export-to ../../dist-dynamic-packages/backend",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.17.7",
    "@backstage/backend-plugin-api": "^1.10.0",
    "@backstage/config": "^1.3.8",
    "@backstage/errors": "^1.3.1",
    "@backstage/integration": "^2.1.1",
    "@backstage/plugin-permission-common": "^0.9.10",
    "@red-hat-developer-hub/backstage-plugin-fullsend-deck-common": "workspace:^",
    "express": "^4.14.0",
    "express-promise-router": "^4.1.0",
    "jszip": "3.10.1",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.6",
    "@backstage/cli": "^0.36.5",
    "@red-hat-developer-hub/cli": "2.0.0",
    "@types/express": "^4.17.6",
    "@types/supertest": "^2.0.12",
    "supertest": "^6.2.4",
    "ts-morph": "28.0.0"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**"
  ]
}
