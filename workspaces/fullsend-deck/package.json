{
  "name": "@internal/fullsend-deck",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/fullsend-deck"
  },
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "node scripts/start-example-app.cjs",
    "start:frontend": "yarn workspace app start",
    "start:backend": "yarn workspace backend start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "export-dynamic": "yarn workspaces foreach --all --topological-dev --include '@red-hat-developer-hub/backstage-plugin-fullsend-deck' --include '@red-hat-developer-hub/backstage-plugin-fullsend-deck-backend' run export-dynamic",
    "package-dynamic": "yarn workspaces foreach --all --topological-dev --include '@red-hat-developer-hub/backstage-plugin-fullsend-deck' --include '@red-hat-developer-hub/backstage-plugin-fullsend-deck-backend' run package-dynamic",
    "conformance:standalone": "node scripts/verify-standalone-conformance.cjs",
    "conformance:artifacts": "node scripts/verify-dynamic-artifacts.cjs",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage --runInBand",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "new": "backstage-cli new --scope @red-hat-developer-hub"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "Apache-2.0"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/cli-defaults": "^0.1.5",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@changesets/cli": "3.0.1",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.17.1"
}
